# Start with demo. No Supabase credentials needed for the local demo.
APP_MODE=demo
PORT=5050

# Only needed when APP_MODE=supabase:
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Backend-only elevated key, NEVER copy into client files or chat:
SUPABASE_SECRET_KEY=YOUR_BACKEND_ONLY_SECRET_KEY

# Razorpay Checkout (optional). Use test keys (rzp_test_...) until go-live.
# The key secret is backend-only; never put it in client code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
